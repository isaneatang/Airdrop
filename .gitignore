# Secrets. Never commit an RPC URL containing an API key, or a deployer key.
.env
.env.*
!.env.example

# Foundry build output
out/
cache/

# Foundry script output. `broadcast/` holds transaction records and `cache/` can hold
# values forge flags as sensitive, so neither belongs in the repo.
broadcast/

# Deployment records written by script/Deploy.s.sol under --broadcast. Commit these
# deliberately if you want the addresses tracked; they are ignored by default so a
# local anvil run never lands in the history as if it were a real deployment.
deployments/

# Frontend build output and deps
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo

# Node
node_modules/

# Generator artefacts are reproducible from tooling/recipients.csv, but tests read
# them, so they stay tracked. Nothing to ignore here.
